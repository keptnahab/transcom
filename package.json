{
  "name": "transcom",
  "version": "0.2.0-beta.1",
  "description": "Local multi-channel audio transcription for live production",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite --config renderer/vite.config.js --port 5747",
    "dev:electron": "wait-on http://localhost:5747 && electron .",
    "build:renderer": "vite build --config renderer/vite.config.js",
    "build:backend": "bash scripts/build_backend_runtime.sh",
    "stage:models": "backend/.venv/bin/python scripts/stage_model_bundle.py",
    "build:editions": "bash scripts/build_editions.sh",
    "upload:beta": "bash scripts/upload_release_to_r2.sh beta",
    "upload:full": "bash scripts/upload_release_to_r2.sh full",
    "test:renderer": "node --test tests_js/*.test.mjs",
    "build": "npm run build:renderer && npm run build:backend && npm run stage:models && electron-builder",
    "start": "electron ."
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.transcom.app",
    "productName": "TransCom",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "release/runtime/backend-runtime",
        "to": "backend-runtime"
      },
      {
        "from": "fixtures",
        "to": "fixtures",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*.onnx"
        ]
      },
      {
        "from": "release/runtime/model-cache",
        "to": "model-cache"
      },
      {
        "from": "release/runtime/model-manifest.json",
        "to": "model-manifest.json"
      },
      {
        "from": "release/runtime/edition.json",
        "to": "edition.json"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dir",
        "zip"
      ]
    }
  }
}
