  "evaluation_policy": {
    "primary_metric": "command_id_exact_accuracy",
    "secondary_metrics": [
      "normalized_phrase_exact_accuracy",
      "word_error_rate",
      "character_error_rate",
      "latency_seconds"
    ],
    "safety_group_scored_separately": true,
    "open_dictation_groups": [
      "alphanumeric",
      "medium",
      "long"
    ],
    "selection_uses_asr_output": false
  },
  "split_policy": {
    "same_across_dev_and_holdout": [
      "command_id",
      "intent_id",
      "allowed_phrases"
    ],
    "required_dev_holdout_disjoint_fields": [
      "utterance_id",
      "speaker",
      "voice",
      "rate",
      "audio_sha256"
    ],
    "holdout_unknown_before_candidate_freeze": [
      "speaker",
      "voice",
      "rate",
      "audio_sha256"
    ],
    "selection_uses_asr_output": false
  },
  "freeze_policy": {
    "catalog_frozen_before_asr": true,
    "catalog_frozen_before_holdout_generation": true,
    "changes_require_new_catalog_id": true
  }
}
