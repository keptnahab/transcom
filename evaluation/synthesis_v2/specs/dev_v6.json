    {"id": "v6-dev-008", "speaker": "Ralf", "role": "Automation", "voice": "Sandy (Deutsch (Deutschland))", "rate": 192, "text": "Position N acht erreicht.", "categories": ["short", "alphanumeric", "number", "technical"]},
    {"id": "v6-dev-009", "speaker": "Bianca", "role": "Licht", "voice": "Anna", "rate": 176, "text": "Linie P fünf aktiv.", "categories": ["short", "alphanumeric", "number", "technical"]},
    {"id": "v6-dev-010", "speaker": "Okan", "role": "Video", "voice": "Eddy (Deutsch (Deutschland))", "rate": 188, "text": "Modul Z drei verbunden.", "categories": ["short", "alphanumeric", "number", "technical"]},
